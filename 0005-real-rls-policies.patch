--- /dev/null
+++ b/supabase/migrations/20260923185710_real_rls_policies.sql
@@ -0,0 +1,727 @@
+-- ============================================================
+-- REPLACE EVERY TEMP/PLACEHOLDER RLS POLICY WITH REAL ONES
+-- ============================================================
+-- Since the project's first migration, every application table has
+-- carried a policy named "temp_allow_all_authenticated" or
+-- "temp_permissive_<table>" reading `using (true) with check (true)`.
+-- That means, until this migration, ANY authenticated user -- any
+-- parent, any student, any teacher, at ANY school -- could read and
+-- write every row in every one of these tables. Not just their own
+-- school's data; all of it. This migration replaces all of them with
+-- real, tenant- and role-scoped policies.
+--
+-- Scope: this migration covers the ~50 application data tables. It does
+-- NOT touch the "temp_allow_authenticated_*" storage bucket policies
+-- (student/staff/parent photos, lesson & curriculum PDFs, news images,
+-- school logos) -- those need the object-path convention worked out
+-- per bucket and are a deliberate, separate follow-up (see note at the
+-- very end of this file).
+--
+-- Every write path here was checked against actual client call sites
+-- across apps/staff, apps/student-parent and apps/super-admin (not
+-- guessed) so this shouldn't remove any access the live apps actually
+-- use. Service-role Edge Functions (account creation, deletion,
+-- payments, webhooks) are unaffected either way -- the service role
+-- key bypasses RLS entirely, by design.
+-- ============================================================
+
+
+-- ============================================================
+-- HELPER FUNCTIONS
+-- ============================================================
+-- SECURITY DEFINER + STABLE so they can read `profiles` from inside
+-- another table's policy without triggering infinite RLS recursion
+-- (profiles' own policy would otherwise re-invoke this same lookup).
+
+create or replace function app_school_id()
+returns uuid
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select school_id from profiles where id = auth.uid()
+$$;
+
+create or replace function app_role()
+returns staff_role
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select role from profiles where id = auth.uid()
+$$;
+
+create or replace function app_is_super_admin()
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (select 1 from profiles where id = auth.uid() and role = 'super_admin')
+$$;
+
+-- "School staff" = a role that runs day-to-day school operations, as
+-- opposed to parent/student (only ever their own slice) or super_admin
+-- (platform-wide, handled separately).
+create or replace function app_is_school_staff()
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1 from profiles
+    where id = auth.uid()
+      and role in ('school_admin', 'class_teacher', 'shadow_teacher', 'finance_manager')
+  )
+$$;
+
+-- True if target_school_id is the caller's own school, or the caller
+-- is super_admin (who can see any school).
+create or replace function app_in_own_school(target_school_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select app_is_super_admin() or target_school_id = app_school_id()
+$$;
+
+-- Staff-write check: same school AND an actual staff role.
+create or replace function app_can_staff_write(target_school_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select app_is_super_admin() or (app_is_school_staff() and target_school_id = app_school_id())
+$$;
+
+-- True if the given students.id row is linked to the calling parent.
+create or replace function app_is_linked_parent(target_student_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1 from parent_student_links
+    where parent_id = auth.uid() and student_id = target_student_id
+  )
+$$;
+
+-- True if the given students.id row is the calling student's own record.
+create or replace function app_is_own_student(target_student_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1 from students
+    where id = target_student_id and profile_id = auth.uid()
+  )
+$$;
+
+
+-- ============================================================
+-- DROP EVERY TEMP/PLACEHOLDER POLICY
+-- ============================================================
+-- (push_subscriptions and the anon schools-read policy are real,
+-- already-correct policies and are intentionally left alone.)
+
+drop policy if exists "temp_allow_all_authenticated" on academic_sessions;
+drop policy if exists "temp_allow_all_authenticated" on activity_reinforcements;
+drop policy if exists "temp_permissive_announcements" on announcements;
+drop policy if exists "temp_permissive_assessment_episodes" on assessment_episodes;
+drop policy if exists "temp_allow_all_authenticated" on attendance;
+drop policy if exists "temp_permissive_audit_logs" on audit_logs;
+drop policy if exists "temp_allow_all_authenticated" on class_activities;
+drop policy if exists "temp_allow_all_authenticated" on class_subjects;
+drop policy if exists "temp_allow_all_authenticated" on class_work;
+drop policy if exists "temp_allow_all_authenticated" on class_work_assignees;
+drop policy if exists "temp_allow_all_authenticated" on classes;
+drop policy if exists "temp_allow_all_authenticated" on conversations;
+drop policy if exists "temp_allow_all_authenticated" on curriculum_documents;
+drop policy if exists "temp_allow_all_authenticated" on curriculum_weeks;
+drop policy if exists "temp_allow_all_authenticated" on daily_teacher_observations;
+drop policy if exists "temp_allow_all_authenticated" on fee_types;
+drop policy if exists "temp_permissive_form1_submissions" on form1_submissions;
+drop policy if exists "temp_permissive_form2_submissions" on form2_submissions;
+drop policy if exists "temp_allow_all_authenticated" on lessons;
+drop policy if exists "temp_allow_all_authenticated" on messages;
+drop policy if exists "temp_permissive_news_posts" on news_posts;
+drop policy if exists "temp_allow_all_authenticated" on notifications;
+drop policy if exists "temp_allow_all_authenticated" on parent_student_links;
+drop policy if exists "temp_allow_all_authenticated" on partnership_pledges;
+drop policy if exists "temp_allow_all_authenticated" on payment_transactions;
+drop policy if exists "temp_allow_all_authenticated" on platform_announcements;
+drop policy if exists "temp_allow_all_authenticated" on platform_settings;
+drop policy if exists "temp_allow_all_authenticated" on profiles;
+drop policy if exists "temp_permissive_promotions" on promotions;
+drop policy if exists "temp_allow_all_authenticated" on prospects;
+drop policy if exists "temp_allow_all_authenticated" on quarterly_subject_scores;
+drop policy if exists "temp_allow_all_authenticated" on quiz_answers;
+drop policy if exists "temp_allow_all_authenticated" on quiz_attempts;
+drop policy if exists "temp_allow_all_authenticated" on quiz_questions;
+drop policy if exists "temp_allow_all_authenticated" on quizzes;
+drop policy if exists "temp_allow_all_authenticated" on school_enabled_levels;
+drop policy if exists "temp_allow_all_authenticated" on school_student_id_counters;
+drop policy if exists "temp_allow_all_authenticated" on schools;
+drop policy if exists "temp_allow_all_authenticated" on shadow_teacher_assignments;
+drop policy if exists "temp_allow_all_authenticated" on shadow_teacher_daily_records;
+drop policy if exists "temp_allow_all_authenticated" on student_badges;
+drop policy if exists "temp_allow_all_authenticated" on student_fees;
+drop policy if exists "temp_permissive_carryovers" on student_subject_carryovers;
+drop policy if exists "temp_permissive_student_subjects" on student_subjects;
+drop policy if exists "temp_allow_all_authenticated" on students;
+drop policy if exists "temp_allow_all_authenticated" on subject_levels;
+drop policy if exists "temp_allow_all_authenticated" on subjects;
+drop policy if exists "temp_allow_all_authenticated" on subscription_fee_schedule;
+drop policy if exists "temp_allow_all_authenticated" on subscription_invoices;
+drop policy if exists "temp_allow_all_authenticated" on subscription_payment_transactions;
+drop policy if exists "temp_allow_all_authenticated" on system_integrations;
+drop policy if exists "temp_allow_all_authenticated" on terms;
+drop policy if exists "temp_permissive_timetable_entries" on timetable_entries;
+drop policy if exists "temp_permissive_timetable_periods" on timetable_periods;
+
+
+-- ============================================================
+-- PROFILES -- self-update only; read within own school (or self,
+-- which "own school" already covers -- a caller's own school_id
+-- trivially equals itself). No client INSERT/DELETE: those only ever
+-- happen via service-role Edge Functions, which bypass RLS anyway.
+-- ============================================================
+
+create policy "profiles_select_own_school" on profiles
+  for select to authenticated
+  using (app_in_own_school(school_id));
+
+create policy "profiles_update_self" on profiles
+  for update to authenticated
+  using (id = auth.uid())
+  with check (id = auth.uid());
+
+
+-- ============================================================
+-- GLOBAL REFERENCE / CURRICULUM LIBRARY -- shared across every school,
+-- not tenant-scoped. Readable by any authenticated user; writable by
+-- super_admin (subjects can also be extended by school staff, since
+-- schools currently add new subject names themselves when setting up
+-- their curriculum).
+-- ============================================================
+
+create policy "subjects_select_all" on subjects
+  for select to authenticated using (true);
+create policy "subjects_insert_staff" on subjects
+  for insert to authenticated
+  with check (app_is_super_admin() or app_is_school_staff());
+create policy "subjects_modify_super_admin" on subjects
+  for update to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+create policy "subjects_delete_super_admin" on subjects
+  for delete to authenticated using (app_is_super_admin());
+
+create policy "subject_levels_select_all" on subject_levels
+  for select to authenticated using (true);
+create policy "subject_levels_write_super_admin" on subject_levels
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+create policy "curriculum_documents_select_all" on curriculum_documents
+  for select to authenticated using (true);
+create policy "curriculum_documents_write_super_admin" on curriculum_documents
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+create policy "curriculum_weeks_select_all" on curriculum_weeks
+  for select to authenticated using (true);
+create policy "curriculum_weeks_write_super_admin" on curriculum_weeks
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+
+-- ============================================================
+-- PLATFORM-WIDE / SUPER-ADMIN-ONLY TABLES
+-- ============================================================
+
+create policy "system_integrations_super_admin" on system_integrations
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+create policy "platform_settings_super_admin" on platform_settings
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+create policy "prospects_super_admin" on prospects
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+-- platform_announcements: super_admin posts them, any authenticated
+-- staff can read them (shown on staff dashboards).
+create policy "platform_announcements_select_all" on platform_announcements
+  for select to authenticated using (true);
+create policy "platform_announcements_write_super_admin" on platform_announcements
+  for all to authenticated using (app_is_super_admin()) with check (app_is_super_admin());
+
+-- schools: any authenticated user can see school records (staff need
+-- their own; the pre-login "host school" branding read is the separate
+-- "temp_allow_anon_read_schools" policy, left as-is, correct as written).
+-- A school_admin may update their own school's profile (name/logo/
+-- contact email); only super_admin creates or deletes schools.
+create policy "schools_select_all" on schools
+  for select to authenticated using (true);
+create policy "schools_update_admin" on schools
+  for update to authenticated
+  using (app_is_super_admin() or (app_role() = 'school_admin' and id = app_school_id()))
+  with check (app_is_super_admin() or (app_role() = 'school_admin' and id = app_school_id()));
+create policy "schools_insert_super_admin" on schools
+  for insert to authenticated with check (app_is_super_admin());
+create policy "schools_delete_super_admin" on schools
+  for delete to authenticated using (app_is_super_admin());
+
+-- school_student_id_counters: intentionally left with NO policies.
+-- It's only ever touched by the set_student_unique_id() trigger, which
+-- is itself SECURITY DEFINER and so bypasses RLS -- no client, staff
+-- or otherwise, has any legitimate reason to read or write it directly.
+
+
+-- ============================================================
+-- SCHOOL-SCOPED STAFF TABLES (direct school_id column)
+-- One combined "for all" policy per table: any staff member (or
+-- super_admin) of that school can read/write; nothing else. This
+-- intentionally does not yet distinguish which staff role should touch
+-- which specific table (e.g. "only finance_manager edits fee_types") --
+-- that's a valuable follow-up, but requires checking every UI entry
+-- point per role to avoid breaking something that works today. This
+-- pass closes the cross-tenant hole, which was the urgent one.
+-- ============================================================
+
+create policy "academic_sessions_school_staff" on academic_sessions
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "classes_school_staff" on classes
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "timetable_periods_school_staff" on timetable_periods
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "timetable_entries_school_staff" on timetable_entries
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "fee_types_school_staff" on fee_types
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "school_enabled_levels_school_staff" on school_enabled_levels
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "announcements_school_staff" on announcements
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "news_posts_school_staff" on news_posts
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+-- News is also shown publicly (school marketing/donation site); keep it
+-- readable by anyone once published, in addition to staff management access.
+create policy "news_posts_select_published_public" on news_posts
+  for select to anon, authenticated using (published = true);
+
+create policy "promotions_school_staff" on promotions
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "student_subject_carryovers_school_staff" on student_subject_carryovers
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "quarterly_subject_scores_school_staff" on quarterly_subject_scores
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+-- Parents and students can also see a child's own finalized scores.
+create policy "quarterly_subject_scores_select_family" on quarterly_subject_scores
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "shadow_teacher_daily_records_school_staff" on shadow_teacher_daily_records
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "shadow_teacher_daily_records_select_family" on shadow_teacher_daily_records
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "class_activities_school_staff" on class_activities
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "daily_teacher_observations_school_staff" on daily_teacher_observations
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "daily_teacher_observations_select_family" on daily_teacher_observations
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "class_work_school_staff" on class_work
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "student_subjects_school_staff" on student_subjects
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "student_subjects_select_family" on student_subjects
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "quizzes_school_staff" on quizzes
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "lessons_school_staff" on lessons
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+-- Platform-subscription tables (the school's own subscription to NATM,
+-- not student fees) -- school_admin of that school, or super_admin.
+create policy "subscription_fee_schedule_admin" on subscription_fee_schedule
+  for all to authenticated
+  using (app_is_super_admin() or (app_role() = 'school_admin' and school_id = app_school_id()))
+  with check (app_is_super_admin() or (app_role() = 'school_admin' and school_id = app_school_id()));
+
+create policy "subscription_invoices_admin" on subscription_invoices
+  for all to authenticated
+  using (app_is_super_admin() or (app_role() = 'school_admin' and school_id = app_school_id()))
+  with check (app_is_super_admin() or (app_role() = 'school_admin' and school_id = app_school_id()));
+
+-- subscription_payment_transactions: only ever written by service-role
+-- Edge Functions (initiate-remita-payment, the Remita webhook); no
+-- client insert/update/delete path exists, so only SELECT is granted.
+create policy "subscription_payment_transactions_select_admin" on subscription_payment_transactions
+  for select to authenticated
+  using (app_is_super_admin() or (app_role() = 'school_admin' and school_id = app_school_id()));
+
+-- payment_transactions (student fee payments): same story -- only
+-- service-role Edge Functions write these. Staff can see their
+-- school's; a parent can see the ones they personally initiated.
+create policy "payment_transactions_select_staff" on payment_transactions
+  for select to authenticated using (app_can_staff_write(school_id));
+create policy "payment_transactions_select_own" on payment_transactions
+  for select to authenticated using (initiated_by = auth.uid());
+
+
+-- ============================================================
+-- SCHOOL-SCOPED STAFF TABLES (indirect -- school_id via a join)
+-- ============================================================
+
+create policy "terms_school_staff" on terms
+  for all to authenticated using (
+    app_can_staff_write((select school_id from academic_sessions where id = terms.session_id))
+  ) with check (
+    app_can_staff_write((select school_id from academic_sessions where id = terms.session_id))
+  );
+-- Terms are read by parent/student apps too (fees, timetable context) --
+-- readable school-wide by anyone in that school, not staff-only.
+create policy "terms_select_same_school" on terms
+  for select to authenticated using (
+    app_in_own_school((select school_id from academic_sessions where id = terms.session_id))
+  );
+
+create policy "class_subjects_school_staff" on class_subjects
+  for all to authenticated using (
+    app_can_staff_write((select school_id from classes where id = class_subjects.class_id))
+  ) with check (
+    app_can_staff_write((select school_id from classes where id = class_subjects.class_id))
+  );
+create policy "class_subjects_select_same_school" on class_subjects
+  for select to authenticated using (
+    app_in_own_school((select school_id from classes where id = class_subjects.class_id))
+  );
+
+create policy "quiz_questions_school_staff" on quiz_questions
+  for all to authenticated using (
+    app_can_staff_write((select school_id from quizzes where id = quiz_questions.quiz_id))
+  ) with check (
+    app_can_staff_write((select school_id from quizzes where id = quiz_questions.quiz_id))
+  );
+-- A student taking the quiz needs to read the questions (never the
+-- correct_answer column client-side by convention -- that's an app-layer
+-- concern; RLS here is row-level, not column-level).
+create policy "quiz_questions_select_student" on quiz_questions
+  for select to authenticated using (
+    exists (
+      select 1 from quiz_attempts
+      where quiz_attempts.quiz_id = quiz_questions.quiz_id
+        and app_is_own_student(quiz_attempts.student_id)
+    )
+  );
+
+create policy "class_work_assignees_school_staff" on class_work_assignees
+  for all to authenticated using (
+    app_can_staff_write((select school_id from class_work where id = class_work_assignees.class_work_id))
+  ) with check (
+    app_can_staff_write((select school_id from class_work where id = class_work_assignees.class_work_id))
+  );
+create policy "class_work_assignees_select_family" on class_work_assignees
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "activity_reinforcements_school_staff" on activity_reinforcements
+  for all to authenticated using (
+    app_can_staff_write((select school_id from students where id = activity_reinforcements.student_id))
+  ) with check (
+    app_can_staff_write((select school_id from students where id = activity_reinforcements.student_id))
+  );
+create policy "activity_reinforcements_select_family" on activity_reinforcements
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+create policy "shadow_teacher_assignments_school_staff" on shadow_teacher_assignments
+  for all to authenticated using (
+    app_can_staff_write((select school_id from students where id = shadow_teacher_assignments.student_id))
+  ) with check (
+    app_can_staff_write((select school_id from students where id = shadow_teacher_assignments.student_id))
+  );
+
+create policy "attendance_school_staff" on attendance
+  for all to authenticated using (
+    app_can_staff_write((select school_id from students where id = attendance.student_id))
+  ) with check (
+    app_can_staff_write((select school_id from students where id = attendance.student_id))
+  );
+create policy "attendance_select_family" on attendance
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+
+-- ============================================================
+-- AUDIT LOG -- staff of that school can read their own school's log
+-- (used by AdminAuditLog); insert is via app code with the caller's own
+-- session (not just Edge Functions), so any school staff can insert for
+-- their own school. No update/delete -- an audit trail that could be
+-- edited or erased after the fact isn't an audit trail.
+-- ============================================================
+
+create policy "audit_logs_select_staff" on audit_logs
+  for select to authenticated using (app_can_staff_write(school_id));
+create policy "audit_logs_insert_staff" on audit_logs
+  for insert to authenticated with check (app_can_staff_write(school_id));
+
+
+-- ============================================================
+-- STUDENTS -- staff of that school full access; a linked parent or the
+-- student themself can read their own row, and update the handful of
+-- self-service fields the app actually lets them touch (profile
+-- contact details, photo, onboarding status) -- RLS is row-level, so
+-- this can't restrict it to *only* those columns, but it does restrict
+-- it to *only their own child's row*, which is the tenant/ownership
+-- boundary that actually matters here.
+-- ============================================================
+
+create policy "students_school_staff" on students
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+create policy "students_select_family" on students
+  for select to authenticated
+  using (app_is_linked_parent(id) or profile_id = auth.uid());
+
+create policy "students_update_family" on students
+  for update to authenticated
+  using (app_is_linked_parent(id) or profile_id = auth.uid())
+  with check (app_is_linked_parent(id) or profile_id = auth.uid());
+
+
+-- ============================================================
+-- PARENT_STUDENT_LINKS -- staff of that school full access (via the
+-- linked student's school); a parent can see their own links and edit
+-- the relationship label on them; a student can see who their own
+-- linked guardians are.
+-- ============================================================
+
+create policy "parent_student_links_school_staff" on parent_student_links
+  for all to authenticated using (
+    app_can_staff_write((select school_id from students where id = parent_student_links.student_id))
+  ) with check (
+    app_can_staff_write((select school_id from students where id = parent_student_links.student_id))
+  );
+
+create policy "parent_student_links_select_own" on parent_student_links
+  for select to authenticated
+  using (parent_id = auth.uid() or app_is_own_student(student_id));
+
+create policy "parent_student_links_update_own" on parent_student_links
+  for update to authenticated
+  using (parent_id = auth.uid())
+  with check (parent_id = auth.uid());
+
+
+-- ============================================================
+-- ASSESSMENT INTAKE (assessment_episodes, form1_submissions) -- staff
+-- of that school full access; a linked parent can create/continue their
+-- own child's intake (this is literally how a parent starts the intake
+-- flow from their own portal).
+-- ============================================================
+
+create policy "assessment_episodes_school_staff" on assessment_episodes
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "assessment_episodes_parent" on assessment_episodes
+  for all to authenticated
+  using (app_is_linked_parent(student_id))
+  with check (app_is_linked_parent(student_id));
+
+create policy "form1_submissions_school_staff" on form1_submissions
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "form1_submissions_parent" on form1_submissions
+  for all to authenticated
+  using (app_is_linked_parent(student_id))
+  with check (app_is_linked_parent(student_id));
+
+-- form2_submissions is filled in by staff during the on-site observation
+-- -- parents/students have no reason to read or write it directly.
+create policy "form2_submissions_school_staff" on form2_submissions
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+
+
+-- ============================================================
+-- MESSAGING (conversations, messages) -- a conversation is strictly
+-- between one parent and one shadow_teacher about one student; only
+-- those two people (plus the school's admin, for oversight) can see or
+-- post in it.
+-- ============================================================
+
+create policy "conversations_participants" on conversations
+  for all to authenticated
+  using (
+    parent_id = auth.uid()
+    or shadow_teacher_id = auth.uid()
+    or (app_role() = 'school_admin' and school_id = app_school_id())
+    or app_is_super_admin()
+  )
+  with check (
+    parent_id = auth.uid()
+    or shadow_teacher_id = auth.uid()
+    or (app_role() = 'school_admin' and school_id = app_school_id())
+    or app_is_super_admin()
+  );
+
+create policy "messages_participants" on messages
+  for all to authenticated
+  using (
+    exists (
+      select 1 from conversations
+      where conversations.id = messages.conversation_id
+        and (
+          conversations.parent_id = auth.uid()
+          or conversations.shadow_teacher_id = auth.uid()
+          or (app_role() = 'school_admin' and conversations.school_id = app_school_id())
+          or app_is_super_admin()
+        )
+    )
+  )
+  with check (
+    exists (
+      select 1 from conversations
+      where conversations.id = messages.conversation_id
+        and (
+          conversations.parent_id = auth.uid()
+          or conversations.shadow_teacher_id = auth.uid()
+          or (app_role() = 'school_admin' and conversations.school_id = app_school_id())
+          or app_is_super_admin()
+        )
+    )
+  );
+
+
+-- ============================================================
+-- NOTIFICATIONS -- strictly private to the recipient; any school staff
+-- can create one (to notify someone else in their school).
+-- ============================================================
+
+create policy "notifications_select_own" on notifications
+  for select to authenticated using (recipient_id = auth.uid());
+create policy "notifications_update_own" on notifications
+  for update to authenticated using (recipient_id = auth.uid()) with check (recipient_id = auth.uid());
+create policy "notifications_insert_staff" on notifications
+  for insert to authenticated with check (app_can_staff_write(school_id));
+
+
+-- ============================================================
+-- PARTNERSHIP_PLEDGES -- a parent pledges support for their own linked
+-- child; staff of that school can see all of their school's pledges.
+-- ============================================================
+
+create policy "partnership_pledges_school_staff" on partnership_pledges
+  for select to authenticated using (app_can_staff_write(school_id));
+create policy "partnership_pledges_parent" on partnership_pledges
+  for all to authenticated
+  using (parent_id = auth.uid() and app_is_linked_parent(student_id))
+  with check (parent_id = auth.uid() and app_is_linked_parent(student_id));
+
+
+-- ============================================================
+-- STUDENT_BADGES (gamification) -- earned client-side by the student
+-- as they complete things; visible to the student, their linked
+-- parent(s), and school staff.
+-- ============================================================
+
+create policy "student_badges_school_staff" on student_badges
+  for select to authenticated using (app_can_staff_write(school_id));
+create policy "student_badges_family" on student_badges
+  for all to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id))
+  with check (app_is_own_student(student_id));
+
+
+-- ============================================================
+-- STUDENT_FEES -- staff of that school manage them; a linked parent (or
+-- the student) can view their own child's fee rows (needed to show what's
+-- owed and pay it), but never write them directly -- amounts only ever
+-- change via staff action or a service-role payment webhook.
+-- ============================================================
+
+create policy "student_fees_school_staff" on student_fees
+  for all to authenticated using (app_can_staff_write(school_id)) with check (app_can_staff_write(school_id));
+create policy "student_fees_select_family" on student_fees
+  for select to authenticated
+  using (app_is_linked_parent(student_id) or app_is_own_student(student_id));
+
+
+-- ============================================================
+-- QUIZ_ATTEMPTS / QUIZ_ANSWERS -- purely self-service and auto-graded;
+-- a student manages their own attempts/answers, staff can view (for
+-- grading dashboards) but never write these directly.
+-- ============================================================
+
+create policy "quiz_attempts_select_staff" on quiz_attempts
+  for select to authenticated using (
+    app_can_staff_write((select school_id from quizzes where id = quiz_attempts.quiz_id))
+  );
+create policy "quiz_attempts_own_student" on quiz_attempts
+  for all to authenticated
+  using (app_is_own_student(student_id))
+  with check (app_is_own_student(student_id));
+
+create policy "quiz_answers_select_staff" on quiz_answers
+  for select to authenticated using (
+    app_can_staff_write((
+      select q.school_id from quiz_attempts qa
+      join quizzes q on q.id = qa.quiz_id
+      where qa.id = quiz_answers.attempt_id
+    ))
+  );
+create policy "quiz_answers_own_student" on quiz_answers
+  for all to authenticated
+  using (
+    exists (select 1 from quiz_attempts where quiz_attempts.id = quiz_answers.attempt_id and app_is_own_student(quiz_attempts.student_id))
+  )
+  with check (
+    exists (select 1 from quiz_attempts where quiz_attempts.id = quiz_answers.attempt_id and app_is_own_student(quiz_attempts.student_id))
+  );
+
+
