+// deno-lint-ignore no-explicit-any
+async function handleSubscriptionPayment(
+  admin: any,
+  txn: any,
+  isSuccess: boolean,
+  remitaStatus: unknown,
+  remitaTransactionId: string | undefined,
+  corsHeaders: Record<string, string>
+): Promise<Response> {
+  if (txn.status !== "pending") {
