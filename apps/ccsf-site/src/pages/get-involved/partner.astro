---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ScrollReveal from "../../components/ScrollReveal";

const potentialPartners = [
  "Government ministries and agencies",
  "Schools and educational institutions",
  "Healthcare providers",
  "Therapy and rehabilitation professionals",
  "Corporate organisations",
  "Non-governmental organisations and foundations",
  "Community organisations",
  "Professional associations",
  "Development agencies",
  "Academic and research institutions",
  "Donors and philanthropic organisations",
];

const partnershipAreas = [
  "Inclusive education programmes",
  "Therapy and developmental support",
  "Teacher and educator training",
  "Parent and caregiver support",
  "Disability awareness and advocacy",
  "Community sensitization",
  "Educational and therapeutic resources",
  "Professional services",
  "Research and learning",
  "Programme funding",
  "Institutional capacity development",
  "Events and outreach activities",
];
---

<SiteLayout
  title="Partner With Us"
  description="Partner with Cherries Children School Foundation. CCSF collaborates with organisations, institutions, and agencies that share its commitment to children with Special Educational Needs."
>
  <section class="bg-pine-900 text-cream-100 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="font-display text-4xl mb-4">Partner With Us</h1>
      <p class="font-body text-cream-100/80">
        Sustainable inclusion is built through strong partnerships.
      </p>
    </div>
  </section>

  <img
    src="https://images.unsplash.com/photo-1710093072228-8c3129f27357?auto=format&fit=crop&w=1600&h=700&q=80"
    alt="Partnership meeting"
    loading="lazy"
    decoding="async"
    class="w-full h-56 sm:h-72 object-cover"
  />

  <ScrollReveal client:visible>
  <section class="bg-cream-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="font-body text-ink/80 leading-relaxed mb-8">
        CCSF welcomes collaboration with organisations and institutions that share our commitment to children with Special Educational Needs, inclusive education, child welfare, family support, and community development.
      </p>
      <h2 class="font-display text-xl text-pine-900 mb-4">Potential Partners May Include</h2>
      <ul class="grid sm:grid-cols-2 gap-2">
        {potentialPartners.map((p) => (
          <li class="font-body text-sm text-ink/70">- {p}</li>
        ))}
      </ul>
    </div>
  </section>
  </ScrollReveal>

  <ScrollReveal client:visible>
  <section class="bg-cream-200 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-display text-xl text-pine-900 mb-4">Areas of Partnership</h2>
      <ul class="grid sm:grid-cols-2 gap-2">
        {partnershipAreas.map((a) => (
          <li class="font-body text-sm text-ink/70">- {a}</li>
        ))}
      </ul>
    </div>
  </section>
  </ScrollReveal>

  <ScrollReveal client:visible>
  <section class="bg-pine-900 text-cream-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-xl mb-4">Partnership Philosophy</h2>
      <p class="font-body text-cream-100/80 leading-relaxed mb-6">
        CCSF values partnerships built on transparency, accountability, mutual respect, shared purpose, and measurable impact.
      </p>
      <p class="font-body text-cream-100/80">
        To discuss a partnership: Phone / WhatsApp
        <a href="https://wa.me/2349153114330" class="text-gold-500 hover:underline">0915 311 4330</a>
      </p>
    </div>
  </section>
  </ScrollReveal>
</SiteLayout>
