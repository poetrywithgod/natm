---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ScrollReveal from "../../components/ScrollReveal";

const supports = [
  "Inclusive education activities",
  "Therapy and developmental support",
  "Individualized learning interventions",
  "Educational and therapeutic resources",
  "Parent and caregiver support",
  "Disability awareness and advocacy",
  "Community engagement activities",
  "Training and capacity development",
  "Programme monitoring and evaluation",
];
---

<SiteLayout
  title="Sponsor a Child's Development"
  description="Support a child with Special Educational Needs at Cherries Children School Foundation. Contributions are pooled to fund inclusive education, therapy, and family support across all children in CCSF's care."
>
  <section class="bg-pine-900 text-cream-100 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="font-display text-4xl mb-4">Sponsor a Child's Development</h1>
      <p class="font-body text-cream-100/80">
        Fund a child's developmental support.
      </p>
    </div>
  </section>

  <ScrollReveal client:visible>
  <section class="bg-cream-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="font-body text-ink/80 leading-relaxed mb-6">
        Sponsoring a child's development means contributing to the resources, services, and interventions required to help children with Special Educational Needs learn, develop, participate, and thrive.
      </p>
      <p class="font-body text-ink/80 leading-relaxed mb-8">
        To protect the privacy and dignity of every child in CCSF's care, sponsorship contributions are pooled across programmes rather than matched to one named child. This ensures every child benefits from consistent, coordinated support, in line with CCSF's child safeguarding policy.
      </p>
      <h2 class="font-display text-xl text-pine-900 mb-4">Your Sponsorship May Support</h2>
      <ul class="grid sm:grid-cols-2 gap-2">
        {supports.map((s) => (
          <li class="font-body text-sm text-ink/70">- {s}</li>
        ))}
      </ul>
    </div>
  </section>
  </ScrollReveal>

  <ScrollReveal client:visible>
  <section class="bg-pine-900 text-cream-100 py-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-2xl mb-8">Official Donation Account</h2>
      <div class="bg-pine-700 rounded-2xl p-8 inline-block text-left">
        <p class="font-body text-sm text-cream-100/70 mb-1">Account Name</p>
        <p class="font-display text-lg mb-4">Cherries Children School Foundation</p>
        <p class="font-body text-sm text-cream-100/70 mb-1">Bank</p>
        <p class="font-display text-lg mb-4">Keystone Bank</p>
        <p class="font-body text-sm text-cream-100/70 mb-1">Account Number</p>
        <p class="font-display text-2xl">1013582929</p>
      </div>
      <p class="font-body text-cream-100/80 mt-8">
        Questions about sponsorship: Phone / WhatsApp
        <a href="https://wa.me/2349153114330" class="text-gold-500 hover:underline">0915 311 4330</a>
      </p>
    </div>
  </section>
  </ScrollReveal>
</SiteLayout>
