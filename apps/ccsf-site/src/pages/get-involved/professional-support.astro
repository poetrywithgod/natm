---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ScrollReveal from "../../components/ScrollReveal";

const professionals = [
  "Special education professionals",
  "Therapists",
  "Behavioural specialists",
  "Healthcare professionals",
  "Psychologists",
  "Social workers",
  "Teachers and educators",
  "Researchers",
  "Child development professionals",
  "Communications specialists",
  "Legal, financial, and governance professionals",
];
---

<SiteLayout
  title="Professional Support"
  description="Cherries Children School Foundation welcomes collaboration with qualified professionals whose expertise can strengthen services for children with Special Educational Needs and their families."
>
  <section class="bg-pine-900 text-cream-100 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="font-display text-4xl mb-4">Professional Support</h1>
      <p class="font-body text-cream-100/80">
        Bring your expertise to strengthen our services.
      </p>
    </div>
  </section>

  <img
    src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1600&h=700&q=80"
    alt="Professionals in consultation"
    loading="lazy"
    decoding="async"
    class="w-full h-56 sm:h-72 object-cover"
  />

  <ScrollReveal client:visible>
  <section class="bg-cream-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="font-body text-ink/80 leading-relaxed mb-8">
        CCSF welcomes collaboration with qualified professionals whose expertise can strengthen services for children and families. Professional involvement must align with CCSF's safeguarding requirements, child-centred approach, confidentiality standards, and relevant professional responsibilities.
      </p>
      <h2 class="font-display text-xl text-pine-900 mb-4">Professionals We Welcome</h2>
      <ul class="grid sm:grid-cols-2 gap-2">
        {professionals.map((p) => (
          <li class="font-body text-sm text-ink/70">- {p}</li>
        ))}
      </ul>
    </div>
  </section>
  </ScrollReveal>

  <ScrollReveal client:visible>
  <section class="bg-pine-900 text-cream-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-xl mb-4">Offer Your Professional Support</h2>
      <p class="font-body text-cream-100/80">
        Phone / WhatsApp
        <a href="https://wa.me/2349153114330" class="text-gold-500 hover:underline">0915 311 4330</a>
      </p>
    </div>
  </section>
  </ScrollReveal>
</SiteLayout>
