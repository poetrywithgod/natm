---
import SiteNav from "../components/SiteNav";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/logo.png" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Cherries Children School Foundation",
  alternateName: "CCSF",
  url: Astro.site?.toString(),
  logo: ogImageURL.toString(),
  description:
    "Inclusive education, therapy, and family support for children with Special Educational Needs in Rivers State, Nigeria.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "15 Uyo Street, Rumuomasi",
    addressLocality: "Port Harcourt",
    addressRegion: "Rivers State",
    addressCountry: "NG",
  },
  telephone: "+2349153114330",
  sameAs: ["https://www.facebook.com/cherries.children"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <title>{title} | Cherries Children School Foundation</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Cherries Children School Foundation" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <header class="bg-pine-900 sticky top-0 z-30 shadow-md relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-20">
          <a href="/" class="flex items-center gap-3">
            <img src="/logo.png" alt="Cherries Children School Foundation" class="h-14 w-auto" />
            <div class="hidden sm:block">
              <p class="font-display text-cream-100 text-lg leading-tight">Cherries Children</p>
              <p class="font-display text-cream-100 text-lg leading-tight -mt-1">School Foundation</p>
            </div>
          </a>

          <SiteNav client:load />

          <div class="hidden sm:flex items-center gap-3">
            <a href="https://wa.me/2349153114330" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp" class="flex items-center justify-center w-10 h-10 rounded-full bg-pine-700 text-cream-100 hover:bg-pine-500 transition-colors">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path><path d="M12.014 2C6.487 2 2 6.487 2 12.014c0 1.988.582 3.842 1.583 5.4L2 22l4.71-1.552a9.964 9.964 0 0 0 5.304 1.517h.004c5.527 0 10.014-4.487 10.014-10.014C22.032 6.487 17.545 2 12.014 2zm0 18.208h-.003a8.16 8.16 0 0 1-4.16-1.14l-.298-.177-3.093 1.02 1.038-3.014-.194-.31a8.174 8.174 0 0 1-1.257-4.37c0-4.515 3.674-8.19 8.193-8.19a8.14 8.14 0 0 1 5.79 2.399 8.14 8.14 0 0 1 2.398 5.792c0 4.516-3.674 8.19-8.19 8.19z"></path></svg>
            </a>
            <a href="/get-involved/donate"
              class="inline-block px-5 py-2 rounded-full bg-cherry-600 text-cream-100 font-body text-sm font-semibold hover:bg-cherry-500 transition-colors"
            >
              Donate
            </a>
          </div>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="bg-pine-900 text-cream-100 pt-14 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
          <div>
            <img src="/logo.png" alt="CCSF" class="h-16 w-auto mb-3" />
            <p class="font-body text-sm text-cream-100/80">
              Providing an environment for inclusive education where the neurodiverse child is given opportunities to learn and thrive.
            </p>
          </div>
          <div>
            <p class="font-display text-base mb-3">Quick Links</p>
            <div class="space-y-2">
              <a href="/about/our-story" class="block font-body text-sm text-cream-100/80 hover:text-gold-500">About Us</a>
              <a href="/programmes" class="block font-body text-sm text-cream-100/80 hover:text-gold-500">Our Programmes</a>
              <a href="/impact" class="block font-body text-sm text-cream-100/80 hover:text-gold-500">Our Impact</a>
              <a href="/get-involved/donate" class="block font-body text-sm text-cream-100/80 hover:text-gold-500">Donate</a>
            </div>
          </div>
          <div>
            <p class="font-display text-base mb-3">Contact</p>
            <div class="space-y-2 font-body text-sm text-cream-100/80">
              <p>15, Uyo Street, Rumuomasi, Port Harcourt, Rivers State, Nigeria</p>
              <p>
                <a href="https://wa.me/2349153114330" class="hover:text-gold-500">0915 311 4330 (Phone / WhatsApp)</a>
              </p>
              <p>
                <a href="https://www.facebook.com/cherries.children" class="hover:text-gold-500" target="_blank" rel="noopener noreferrer">Facebook</a>
              </p>
            </div>
          </div>
          <div>
            <p class="font-display text-base mb-3">Donate Directly</p>
            <div class="font-body text-sm text-cream-100/80 space-y-1">
              <p>Keystone Bank</p>
              <p>Cherries Children School Foundation</p>
              <p class="font-semibold text-cream-100">1013582929</p>
            </div>
          </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-10 pt-6 border-t border-pine-700 flex flex-col sm:flex-row justify-between gap-2">
          <p class="font-body text-xs text-cream-100/60">
            &copy; {new Date().getFullYear()} Cherries Children School Foundation. CAC Reg. No. 7332638.
          </p>
          <p class="font-body text-xs text-cream-100/60">CCSF protects the privacy and dignity of every child in our care.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
